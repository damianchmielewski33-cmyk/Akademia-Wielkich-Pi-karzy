# Publiczny adres strony (https://…), bez końcowego „/”. Kanoniczne URL-e, sitemap i robots dla Google.
NEXT_PUBLIC_SITE_URL=

# Alias originu aplikacji (maile, przekierowania). Na Renderze ustaw ten sam co NEXT_PUBLIC_SITE_URL.
# NEXT_PUBLIC_APP_URL=

# --- Render Free (produkcja tymczasowa) ---
# Web Service: Build `npm install && npm run build`, Start `npm start` (nasłuchuje PORT).
# Sugerowany URL: https://akademia-wielkich-pilkarzy.onrender.com (potwierdź w dashboardzie).
# RENDER_EXTERNAL_URL — ustawia Render automatycznie; CSRF / Origin z niej czyta allowlistę.
# RENDER_EXTERNAL_URL=
# Opcjonalnie dodatkowe originy CSV (preview, custom domain):
# CSRF_ALLOWED_ORIGINS=https://inne.example.com
# Opcjonalny monitoring limitu Free (~5 GB/mies.):
# RENDER_API_KEY=
# RENDER_SERVICE_ID=
# RENDER_BANDWIDTH_LIMIT_GB=5
#
# Cron na Renderze: Vercel Cron nie działa — Cron Job albo zewnętrzny ping:
#   GET /api/cron/database-cleanup  Authorization: Bearer <CRON_SECRET>
# Realtime: krótki HTTP poll (lib/realtime-poll-config.ts) — bez SSE.
# Szczegóły: docs/render-free.md

# Siostrzana aplikacja GymBrat (przejścia Start/stopka). Tymczasowo Render Free.
# NEXT_PUBLIC_GYMBRAT_URL=https://gymbrat.onrender.com
# Opcjonalnie kanoniczny origin AWP (embed / cross-linki):
# NEXT_PUBLIC_AWP_URL=https://akademia-wielkich-pilkarzy.onrender.com
# NEXT_PUBLIC_AWP_EMBED_ORIGINS=

# Google AdSense (opcjonalnie): Publisher ID ca-pub-…. Można też ustawić w panelu admina → Ustawienia.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-

# HotPay (opcjonalnie): bez tych zmiennych strona płatności pokazuje tylko BLIK.# Sekret serwisu i hasło notyfikacji z panelu HotPay → lista serwisów → ustawienia.
# Adres notyfikacji w panelu: {NEXT_PUBLIC_SITE_URL}/api/wallet/hotpay/notification
# HOTPAY_SEKRET=
# HOTPAY_NOTIFICATION_PASSWORD=
# HOTPAY_SERVICE_NAME=Akademia Wielkich Piłkarzy — wpisowe
# Whitelist IP HotPay dla webhooka: w produkcji WŁĄCZONA domyślnie (HASH + SEKRET nadal wymagane).
# HOTPAY_ENFORCE_IP=0  — wyłącz (np. lokalnie / gdy proxy zmienia IP)
# HOTPAY_ENFORCE_IP=1  — wymuś także poza produkcją
# HOTPAY_ENFORCE_IP=
# HOTPAY_ABANDONED_MINUTES=60  — po ilu min anulować pending i sprzątać porzuconych gości
# HOTPAY_RETENTION_DAYS=90     — retencja anulowanych/odrzuconych płatności i koszyków

# Opcjonalnie: bezpośredni URL do APK Androida (domyślnie GitHub Releases …/akademia-wp.apk).
# NEXT_PUBLIC_ANDROID_APK_URL=
# Po cutoverze na Render: przebuduj APK z API_BASE_URL = origin Render (źródła android/ lokalnie).
# ANDROID_API_BASE_URL=https://akademia-wielkich-pilkarzy.onrender.com/

# Android App Links (/zaproszenie, /platnosci, /platnosci-public — otwieranie w APK).
# Główna ścieżka płatności w aplikacji: HotPay zostaje w WebView (łącznie z 3DS).
# App Links + fingerprinty są potrzebne, gdy link otworzy się poza WebView.
# Wymagane w produkcji: SHA-256 odcisk klucza RELEASE (nie debug), np.:
#   keytool -list -v -keystore <release.keystore> -alias <alias>
# Wiele fingerprintów: oddziel przecinkiem lub nową linią.
# Bez tego Digital Asset Links nie zweryfikują App Links (Chrome zostawi link w przeglądarce).
# Endpoint: /.well-known/assetlinks.json
# Sprawdzenie: https://developers.google.com/digital-asset-links/tools/generator
ANDROID_APP_PACKAGE_NAME=pl.akademiawielkichpilkarzy.player
ANDROID_APP_SHA256_CERT_FINGERPRINTS=
# Opcjonalnie dla klienta (Intent URL):
# NEXT_PUBLIC_ANDROID_APP_PACKAGE_NAME=pl.akademiawielkichpilkarzy.player

# Universal Links iOS (tylko natywna aplikacja z Associated Domains — nie dotyczy PWA z Safari):
# IOS_APP_TEAM_ID=
# IOS_APP_BUNDLE_ID=pl.akademiawielkichpilkarzy.app
# Endpoint: /.well-known/apple-app-site-association

# Awaria logowania (utracony PIN_PEPPER): logowanie samym imieniem i nazwiskiem, PIN zablokowany w UI.
# Wystarczy jedna z nich (=1). Po odzyskaniu dostępu USUŃ i redeploy!
# ENABLE_EMERGENCY_NAME_ONLY_LOGIN=1
# NEXT_PUBLIC_EMERGENCY_NAME_ONLY_LOGIN=1

# W produkcji ustaw silny sekret (min. 32 znaki). Bez tego aplikacja nie wystartuje.
AUTH_SECRET=

# --- E-mail (Nodemailer / SMTP) — kody rejestracji, reset PIN/hasła ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM="Akademia Wielkich Piłkarzy <noreply@example.com>"

# Testowy kod z maila 123456:
# - poza produkcją: dla wszystkich
# - na produkcji: tylko dla kont admina (is_admin=1)
# EMAIL_AUTH_ALLOW_MOCK_CODE nie jest już potrzebne.
# Opcjonalnie (zalecane w produkcji): "pepper" dla PIN-u — sekret poza bazą danych.
# Po ustawieniu aplikacja będzie akceptować też stare hashe (bez peppera) i zaktualizuje je przy udanym logowaniu.
# Zalecane ≥ 16 losowych znaków.
PIN_PEPPER=

# Rejestracja samoobsługowa: w produkcji domyślnie wyłączona po utworzeniu pierwszego konta.
# Ustaw na 1, aby zezwolić na otwartą rejestrację (np. okres naboru).
ALLOW_SELF_REGISTRATION=

# Cron: nagłówek Authorization: Bearer <CRON_SECRET> dla /api/cron/database-cleanup
# Na Renderze: Cron Job albo zewnętrzny scheduler (Vercel Cron z vercel.json nie działa).
CRON_SECRET=

# Firebase Cloud Messaging (push na Androida). Jedna z opcji:
# A) cały JSON service account w jednej zmiennej (zalecane na Vercel/Render):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# B) osobne pola:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Web Push (Safari PWA na iOS 16.4+, Chrome/Firefox na desktopie i Androidzie).
# Wygeneruj parę: npx web-push generate-vapid-keys
# Publiczny klucz musi być w NEXT_PUBLIC_ (trafia do klienta przy subscribe).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Opcjonalnie subject VAPID (mailto:… albo https://…); domyślnie bazowy URL aplikacji.
# VAPID_SUBJECT=mailto:admin@example.com

# Opcjonalnie: ścieżka do pliku SQLite względem katalogu projektu
# DATABASE_PATH=data/database.db

# Produkcja (Render / Vercel): zdalna baza libSQL (Turso). Bez tego każda instancja ma osobny dysk — dane nie są współdzielone.
# Lokalnie zwykle puste: wtedy używany jest plik SQLite powyżej.
# Utwórz bazę w https://turso.tech , skopiuj URL oraz token do zmiennych na hoście i wdróż ponownie.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (uploady: logo, zdjęcia profilowe, załączniki czatu).
# Token działa też poza Vercellem, jeśli Blob Store jest aktywny.
# Bez tego pliki mogą trafić do lokalnego dysku i zniknąć po restarcie.
# BLOB_READ_WRITE_TOKEN=

# Osobna baza TRYBU TESTOWEGO admina (druga baza Turso — nie ta sama co produkcja).
# Z Turso PROD: wymagane. Lokalnie bez Turso: domyślnie data/database-test.db.
# TURSO_TEST_DATABASE_URL=
# TURSO_TEST_AUTH_TOKEN=
# DATABASE_TEST_PATH=data/database-test.db
#
# Tryb testowy (panel → Ustawienia / przycisk w sidebarze):
# sesja admina przełącza getDb() na bazę TEST; gracze zawsze widzą PROD.
# Flaga users.test_mode_enabled jest w PROD (przetrwa powrót z HotPay).
# HotPay w teście: session_id z prefixem hp_t_ → webhook/status idą do bazy TEST.
# Wyłączenie trybu czyści całą bazę TEST.

# Jednorazowo po utworzeniu pustej bazy w Turso (tworzy tabele): npm run db:init-turso
# Dla bazy TEST ustaw tymczasowo TURSO_DATABASE_URL na URL testowy i odpal ten sam skrypt, albo włącz raz tryb testowy (schema init przy getTestDb).

# Opcjonalnie: prognoza w terminarzu z Google Weather (10 dni). Ten sam klucz: Geocoding API + Weather API w Google Cloud.
# Bez klucza aplikacja używa darmowego Open-Meteo (nadaje się do testów; do produkcji rozważ klucz Google).
# Alternatywne nazwy zmiennej (jeśli używasz innej konwencji): GOOGLE_CLOUD_MAPS_API_KEY, MAPS_PLATFORM_SERVER_KEY
GOOGLE_MAPS_API_KEY=
# GOOGLE_CLOUD_MAPS_API_KEY=
# MAPS_PLATFORM_SERVER_KEY=

# Opcjonalnie: własny User-Agent do geokodowania Nominatim (OpenStreetMap), gdy domyślny jest odrzucany.
# NOMINATIM_USER_AGENT=
