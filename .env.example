# Publiczny adres strony (https://…), bez końcowego „/”. Kanoniczne URL-e, sitemap i robots dla Google.
NEXT_PUBLIC_SITE_URL=

# Siostrzana aplikacja GymBrat (przejścia Start/stopka). Domyślnie https://gym-brat.vercel.app
# NEXT_PUBLIC_GYMBRAT_URL=https://gym-brat.vercel.app

# Google AdSense (opcjonalnie): Publisher ID ca-pub-…. Można też ustawić w panelu admina → Ustawienia.
# NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-

# HotPay (opcjonalnie): bez tych zmiennych strona płatności pokazuje tylko BLIK.# Sekret serwisu i hasło notyfikacji z panelu HotPay → lista serwisów → ustawienia.
# Adres notyfikacji w panelu: {NEXT_PUBLIC_SITE_URL}/api/wallet/hotpay/notification
# HOTPAY_SEKRET=
# HOTPAY_NOTIFICATION_PASSWORD=
# HOTPAY_SERVICE_NAME=Akademia Wielkich Piłkarzy — wpisowe
# Whitelist IP HotPay dla webhooka: domyślnie WYŁĄCZONA (autentykacja = HASH + SEKRET).
# HOTPAY_ENFORCE_IP=1  — włącz whitelistę IP z dokumentacji HotPay
# HOTPAY_ENFORCE_IP=

# Opcjonalnie: bezpośredni URL do APK Androida (domyślnie GitHub Releases …/akademia-wp.apk).
# NEXT_PUBLIC_ANDROID_APK_URL=

# Android App Links (/zaproszenie, /platnosci — backup przy powrocie z HotPay).
# Główna ścieżka płatności w aplikacji: HotPay zostaje w WebView (łącznie z 3DS).
# App Links + fingerprinty są potrzebne, gdy link otworzy się poza WebView.
# Wymagane w produkcji: SHA-256 odcisk klucza RELEASE (nie debug), np.:
#   keytool -list -v -keystore <release.keystore> -alias <alias>
# Wiele fingerprintów: oddziel przecinkiem lub nową linią.
# Bez tego Digital Asset Links nie zweryfikują App Links.
# Endpoint: /.well-known/assetlinks.json
ANDROID_APP_PACKAGE_NAME=pl.akademiawielkichpilkarzy.player
ANDROID_APP_SHA256_CERT_FINGERPRINTS=

# W produkcji ustaw silny sekret (min. 32 znaki). Bez tego aplikacja nie wystartuje.
AUTH_SECRET=

# Opcjonalnie (zalecane w produkcji): "pepper" dla PIN-u — sekret poza bazą danych.
# Po ustawieniu aplikacja będzie akceptować też stare hashe (bez peppera) i zaktualizuje je przy udanym logowaniu.
# Zalecane ≥ 16 losowych znaków.
PIN_PEPPER=

# Rejestracja samoobsługowa: w produkcji domyślnie wyłączona po utworzeniu pierwszego konta.
# Ustaw na 1, aby zezwolić na otwartą rejestrację (np. okres naboru).
ALLOW_SELF_REGISTRATION=

# Cron (np. Vercel): nagłówek Authorization: Bearer <CRON_SECRET> dla /api/cron/database-cleanup
CRON_SECRET=

# Firebase Cloud Messaging (push na Androida). Jedna z opcji:
# A) cały JSON service account w jednej zmiennej (zalecane na Vercel):
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
# B) osobne pola:
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Web Push (Safari PWA na iOS 16.4+, Chrome/Firefox na desktopie i Androidzie).
# Wygeneruj parę: npx web-push generate-vapid-keys
# Publiczny klucz musi być w NEXT_PUBLIC_ (trafia do klienta przy subscribe).
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# Opcjonalnie subject VAPID (mailto:… albo https://…); domyślnie bazowy URL aplikacji.
# VAPID_SUBJECT=mailto:admin@example.com

# Opcjonalnie: ścieżka do pliku SQLite względem katalogu projektu
# DATABASE_PATH=data/database.db

# Produkcja (Vercel / serverless): zdalna baza libSQL (Turso). Bez tego każda instancja ma osobny /tmp — dane nie są współdzielone.
# Lokalnie zwykle puste: wtedy używany jest plik SQLite powyżej.
# Utwórz bazę w https://turso.tech , skopiuj URL oraz token do zmiennych w Vercel → Environment Variables i wdróż ponownie.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Vercel Blob (wymagane na Vercel do uploadów: logo, zdjęcia profilowe, załączniki czatu).
# Bez tego pliki trafiają do /tmp i znikają → 404 na /api/uploads/...
# Vercel → Storage → Blob → Connect to Project (ustawia BLOB_READ_WRITE_TOKEN automatycznie).
# BLOB_READ_WRITE_TOKEN=

# Osobna baza TRYBU TESTOWEGO admina (druga baza Turso — nie ta sama co produkcja).
# Na Vercelu z Turso PROD: wymagane. Lokalnie bez Turso: domyślnie data/database-test.db.
# TURSO_TEST_DATABASE_URL=
# TURSO_TEST_AUTH_TOKEN=
# DATABASE_TEST_PATH=data/database-test.db
#
# Tryb testowy (panel → Ustawienia / przycisk w sidebarze):
# sesja admina przełącza getDb() na bazę TEST; gracze zawsze widzą PROD.
# Flaga users.test_mode_enabled jest w PROD (przetrwa powrót z HotPay).
# HotPay w teście: session_id z prefixem hp_t_ → webhook/status idą do bazy TEST.
# Wyłączenie trybu czyści całą bazę TEST.

# Jednorazowo po utworzeniu pustej bazy w Turso (tworzy tabele): npm run db:init-turso
# Dla bazy TEST ustaw tymczasowo TURSO_DATABASE_URL na URL testowy i odpal ten sam skrypt, albo włącz raz tryb testowy (schema init przy getTestDb).

# Opcjonalnie: prognoza w terminarzu z Google Weather (10 dni). Ten sam klucz: Geocoding API + Weather API w Google Cloud.
# Bez klucza aplikacja używa darmowego Open-Meteo (nadaje się do testów; do produkcji rozważ klucz Google).
# Alternatywne nazwy zmiennej (jeśli używasz innej konwencji): GOOGLE_CLOUD_MAPS_API_KEY, MAPS_PLATFORM_SERVER_KEY
GOOGLE_MAPS_API_KEY=
# GOOGLE_CLOUD_MAPS_API_KEY=
# MAPS_PLATFORM_SERVER_KEY=

# Opcjonalnie: własny User-Agent do geokodowania Nominatim (OpenStreetMap), gdy domyślny jest odrzucany.
# NOMINATIM_USER_AGENT=
