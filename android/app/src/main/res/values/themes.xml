<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Awp" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/awp_green_dark</item>
        <item name="android:windowBackground">@color/awp_green_dark</item>
        <item name="android:colorPrimary">@color/awp_green</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>

    <!-- System splash od pierwszego kadru procesu — potem Compose przejmuje animację. -->
    <style name="Theme.Awp.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/awp_green_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_round</item>
        <item name="postSplashScreenTheme">@style/Theme.Awp</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/awp_green_dark</item>
    </style>
</resources>
