# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/gymbrat/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/gymbrat/.next/
/out/
/gymbrat/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env.*.local
!.env.example

# lokalna baza SQLite (opcjonalnie commituj pusta strukture)
/data/*.db
/data/*.db-wal
/data/*.db-shm
/data/backups/

# vercel
.vercel
/gymbrat/.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Android
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/.idea/
/android/*.iml
/android/captures/
/android/.cxx/
/tmp-apk/

# GymBrat (osobny npm install w gymbrat/)
/gymbrat/.idea/

# zdjęcia profilowe (lokalnie)
/public/uploads/profiles/*
!/public/uploads/profiles/.gitkeep
.env*
